# AWS Configuration
# AWS_REGION is set automatically by Lambda, only set for local development
# AWS_REGION=eu-west-1
DYNAMODB_TABLE_NAME=movgr-metro-arrivals

# For local development with DynamoDB Local (optional)
# DYNAMODB_ENDPOINT_URL=http://localhost:8000

# Set to "false" to use direct scraping (legacy mode)
USE_DYNAMODB=true

# In-memory cache TTL in seconds (reduces DynamoDB reads for warm Lambda instances)
# Set to 0 to disable in-memory caching
MEMORY_CACHE_TTL=5

# Scraper configuration
SCRAPE_TIMEOUT=10
METRO_SOURCE_URL=https://metropolitanogranada.es/MGhorariosreal.asp

# CORS (comma-separated list of origins)
CORS_ORIGINS=*
